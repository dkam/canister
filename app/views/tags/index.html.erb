<% content_for :title, "Tags" %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Tags</h1>
    <p class="text-sm text-gray-500"><%= @tags.size %> tags</p>
  </div>

  <%# Group alphabetically %>
  <% grouped = @tags.group_by { |t| t.name[0].upcase rescue "#" } %>
  <% grouped.sort.each do |letter, tags| %>
    <div class="mb-6">
      <h2 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-2 border-b border-gray-100 pb-1">
        <%= letter %>
      </h2>
      <div class="flex flex-wrap gap-2">
        <% tags.each do |tag| %>
          <%= link_to scenes_path(tags: [tag.id]),
                class: "inline-flex items-center gap-1.5 bg-white border border-gray-200 rounded-full px-3 py-1.5 text-sm hover:border-indigo-300 hover:text-indigo-700 transition-colors group" do %>
            <span class="text-gray-700 group-hover:text-indigo-700"><%= tag.name %></span>
            <span class="text-xs text-gray-400 bg-gray-100 rounded-full px-1.5 py-0.5 group-hover:bg-indigo-50 group-hover:text-indigo-500">
              <%= tag.scenes_count %>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
