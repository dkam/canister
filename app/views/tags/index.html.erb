<% content_for :title, "Tags" %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Tags</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400"><%= @tags.length %> tags</p>
  </div>

  <%# Group alphabetically %>
  <% grouped = @tags.group_by { |t| t.name[0].upcase rescue "#" } %>
  <% grouped.sort.each do |letter, tags| %>
    <div class="mb-6">
      <h2 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-2 border-b border-gray-100 dark:border-gray-700 pb-1">
        <%= letter %>
      </h2>
      <div class="flex flex-wrap gap-2">
        <% tags.each do |tag| %>
          <%= link_to videos_path(tags: [tag.id]),
                class: "inline-flex items-center gap-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full px-3 py-1.5 text-sm hover:border-indigo-300 dark:hover:border-indigo-600 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors group" do %>
            <span class="text-gray-700 dark:text-gray-300 group-hover:text-indigo-700 dark:group-hover:text-indigo-300"><%= tag.name %></span>
            <span class="text-xs text-gray-400 bg-gray-100 dark:bg-gray-700 rounded-full px-1.5 py-0.5 group-hover:bg-indigo-50 dark:group-hover:bg-indigo-900/20 group-hover:text-indigo-500 dark:group-hover:text-indigo-400">
              <%= tag.videos_count %>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
