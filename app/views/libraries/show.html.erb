<% content_for :title, @library.name %>

<%= turbo_stream_from @library %>
<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex gap-6">

    <%# Sidebar %>
    <aside class="w-56 xl:w-64 shrink-0">
      <div class="sticky top-20 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4 space-y-4">
        <%= render @library %>
      </div>
    </aside>

    <%# Main content %>
    <div class="flex-1 min-w-0">
      <% unless @videos.empty? %>
        <div class="flex items-center justify-between mb-4">
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= raw @pagy.info_tag %></p>
          <%= form_with url: library_path(@library), method: :get, class: "flex gap-2 items-center" do |f| %>
            <%= f.select :sort,
                  [["Date Added", "created_at"], ["Title", "title"], ["Published Date", "date"], ["Rating", "rating"], ["Duration", "duration"], ["File Size", "size"], ["Random", "random"], ["Path", "path"]],
                  { selected: params[:sort] || "created_at" },
                  class: "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-lg px-3 py-1.5 text-sm focus:ring-indigo-500 dark:focus:ring-indigo-400 focus:border-indigo-500 dark:focus:border-indigo-400",
                  onchange: "this.form.requestSubmit()" %>
            <%= f.select :direction,
                  [["Asc ↑", "asc"], ["Desc ↓", "desc"]],
                  { selected: params[:direction] || "desc" },
                  class: "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-lg px-3 py-1.5 text-sm focus:ring-indigo-500 dark:focus:ring-indigo-400 focus:border-indigo-500 dark:focus:border-indigo-400",
                  onchange: "this.form.requestSubmit()" %>
          <% end %>
        </div>
      <% end %>

      <div id="library_<%= @library.id %>_videos" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 xl:grid-cols-4 gap-4">
        <% @videos.each do |video| %>
          <%= render "shared/video_card", video: video %>
        <% end %>
      </div>

      <% if @videos.empty? %>
        <p class="text-gray-400 dark:text-gray-500 py-12 text-center">No videos in this library.</p>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="mt-6 flex justify-center">
          <%= raw @pagy.series_nav %>
        </div>
      <% end %>
    </div>

  </div>
</div>
