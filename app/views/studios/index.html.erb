<% content_for :title, "Studios" %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">

  <%# Search %>
  <%= form_with url: studios_path, method: :get, class: "mb-6 flex gap-3 max-w-md" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "Search studios…",
          class: "flex-1 border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    <%= f.submit "Search", class: "bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg px-4 py-2 text-sm font-medium" %>
  <% end %>

  <%# Count %>
  <p class="text-sm text-gray-500 mb-4"><%= raw @pagy.info_tag %></p>

  <%# Studio cards %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
    <% @studios.each do |studio| %>
      <%= link_to studio_path(studio),
            class: "block bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden text-center group p-4" do %>
        <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-gray-100 overflow-hidden">
          <img src="<%= image_studio_path(studio) %>"
               alt="<%= studio.name %>"
               loading="lazy"
               class="w-full h-full object-cover"
               onerror="this.style.display='none'">
        </div>
        <p class="text-sm font-medium text-gray-900 truncate"><%= studio.name %></p>
        <p class="text-xs text-gray-400 mt-0.5"><%= studio.scenes.size %> scenes</p>
      <% end %>
    <% end %>
  </div>

  <% if @studios.empty? %>
    <div class="text-center py-16 text-gray-400">
      <p class="text-lg">No studios found.</p>
    </div>
  <% end %>

  <%# Pagination %>
  <div class="mt-6 flex justify-center">
    <%= raw @pagy.series_nav %>
  </div>

</div>
