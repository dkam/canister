<% content_for :title, "Videos" %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex gap-6">

    <%# Sidebar filters (desktop) %>
    <aside class="hidden lg:block w-56 xl:w-64 shrink-0">
      <div class="sticky top-20 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4">
        <%= render "shared/filter_sidebar" %>
      </div>
    </aside>

    <%# Main content %>
    <div class="flex-1 min-w-0" data-controller="view-mode" data-view-mode-key-value="videos">

      <%# Toolbar: result count + view mode toggle %>
      <div class="flex items-center justify-between mb-4">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          <%= raw @pagy.info_tag %>
        </p>
        <div class="flex items-center gap-1 bg-gray-100 dark:bg-gray-700 rounded-lg p-1">
          <button data-action="click->view-mode#grid"
                  data-view-mode-target="gridBtn"
                  title="Grid view"
                  class="p-1.5 rounded text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-white dark:hover:bg-gray-600 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
            </svg>
          </button>
          <button data-action="click->view-mode#list"
                  data-view-mode-target="listBtn"
                  title="List view"
                  class="p-1.5 rounded text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-white dark:hover:bg-gray-600 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
            </svg>
          </button>
          <button data-action="click->view-mode#wall"
                  data-view-mode-target="wallBtn"
                  title="Wall view"
                  class="p-1.5 rounded text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-white dark:hover:bg-gray-600 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3 3h6v6H3V3zm8 0h6v4h-6V3zm0 6h6v8h-6V9zM3 11h6v6H3v-6z"/>
            </svg>
          </button>
        </div>
      </div>

      <%= turbo_stream_from "videos" %>

      <%# Videos list (Turbo Frame target for filter updates) %>
      <turbo-frame id="videos" data-turbo-action="advance" data-controller="queue">
        <%# Grid view (default) %>
        <div data-view-mode-target="gridContainer"
             id="videos_grid"
             class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 xl:grid-cols-4 gap-4">
          <% @videos.each do |video| %>
            <%= render "shared/video_card", video: video %>
          <% end %>
        </div>

        <%# List view %>
        <div data-view-mode-target="listContainer" class="hidden">
          <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
            <% @videos.each do |video| %>
              <div class="flex items-center gap-4 p-3 hover:bg-gray-50 dark:hover:bg-gray-700">
                <img src="<%= screenshot_video_path(video) %>"
                     alt=""
                     loading="lazy"
                     class="w-24 aspect-video object-cover rounded shrink-0">
                <div class="flex-1 min-w-0">
                  <%= link_to video.title.presence || File.basename(video.path, ".*"), video_path(video),
                        data: { turbo_frame: "_top" },
                        class: "text-sm font-medium text-gray-900 dark:text-gray-100 hover:text-indigo-600 dark:hover:text-indigo-400 truncate block" %>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    <%= [video.studio&.name, video.date&.year, format_duration(video.duration)].compact.join(" · ") %>
                  </p>
                  <% if video.people.any? %>
                    <p class="text-xs text-gray-400 truncate"><%= video.people.map(&:name).join(", ") %></p>
                  <% end %>
                </div>
                <% if video.rating.present? && video.rating > 0 %>
                  <div class="text-xs shrink-0"><%= rating_stars(video.rating) %></div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%# Wall view (masonry-like via CSS columns) %>
        <div data-view-mode-target="wallContainer" class="hidden columns-2 sm:columns-3 lg:columns-4 xl:columns-5 gap-3 space-y-3">
          <% @videos.each do |video| %>
            <div class="break-inside-avoid">
              <%= render "shared/video_card", video: video %>
            </div>
          <% end %>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="mt-6 flex justify-center">
            <%= raw @pagy.series_nav %>
          </div>
        <% end %>
      </turbo-frame>

      <% if @videos.empty? %>
        <div class="text-center py-16 text-gray-400 dark:text-gray-500">
          <p class="text-lg">No videos found.</p>
          <% if @filters_active %>
            <%= link_to "Clear filters", videos_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline text-sm mt-2 inline-block" %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
