<% content_for :title, @library.name %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex gap-6">

    <%# Sidebar %>
    <aside class="w-56 xl:w-64 shrink-0">
      <div class="sticky top-20 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4 space-y-4">
        <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= @library.name %></h1>

        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Kind</dt>
            <dd>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300">
                <%= @library.kind %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Path</dt>
            <dd class="font-mono text-gray-900 dark:text-gray-100 break-all"><%= @library.path %></dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Read Only</dt>
            <dd class="text-gray-900 dark:text-gray-100"><%= @library.read_only? ? "Yes" : "No" %></dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Default Video Kind</dt>
            <dd class="text-gray-900 dark:text-gray-100"><%= @library.default_video_kind || "video" %></dd>
          </div>
          <% if @library.username.present? %>
            <div>
              <dt class="text-gray-500 dark:text-gray-400">Username</dt>
              <dd class="text-gray-900 dark:text-gray-100"><%= @library.username %></dd>
            </div>
          <% end %>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Scenes</dt>
            <dd class="text-gray-900 dark:text-gray-100"><%= @library.scenes.size %></dd>
          </div>
        </dl>

        <div class="flex flex-col gap-2 pt-2 border-t border-gray-200 dark:border-gray-700">
          <%= link_to "Edit", edit_library_path(@library),
                class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
          <%= button_to "Scan", scan_library_path(@library), method: :post,
                class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline text-left" %>
          <%= button_to "Delete", library_path(@library), method: :delete,
                data: { turbo_confirm: "Delete library \"#{@library.name}\"? Scenes will be kept but unlinked." },
                class: "text-sm text-red-600 dark:text-red-400 hover:underline text-left" %>
        </div>
      </div>
    </aside>

    <%# Main content %>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between mb-4">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= raw @pagy.info_tag %></p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 xl:grid-cols-4 gap-4">
        <% @scenes.each do |scene| %>
          <%= render "shared/scene_card", scene: scene %>
        <% end %>
      </div>

      <% if @scenes.empty? %>
        <p class="text-gray-400 dark:text-gray-500 py-12 text-center">No scenes in this library.</p>
      <% end %>

      <div class="mt-6 flex justify-center">
        <%= raw @pagy.series_nav %>
      </div>
    </div>

  </div>
</div>
