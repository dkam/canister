<% content_for :title, @studio.name %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">

  <%# Studio header %>
  <div class="flex items-center gap-4 mb-6">
    <div class="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-700 overflow-hidden shrink-0">
      <img src="<%= image_studio_path(@studio) %>"
           alt="<%= @studio.name %>"
           class="w-full h-full object-cover"
           onerror="this.style.display='none'">
    </div>
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= @studio.name %></h1>
      <% if @studio.url.present? %>
        <a href="<%= @studio.url %>" target="_blank" class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">
          <%= @studio.url %>
        </a>
      <% end %>
    </div>
    <div class="ml-auto">
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= raw @pagy.info_tag %></p>
    </div>
  </div>

  <%# Videos grid %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-4">
    <% @videos.each do |video| %>
      <%= render "shared/video_card", video: video %>
    <% end %>
  </div>

  <% if @videos.empty? %>
    <p class="text-gray-400 dark:text-gray-500 py-12 text-center">No videos found for this studio.</p>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="mt-6 flex justify-center">
      <%= raw @pagy.series_nav %>
    </div>
  <% end %>

</div>
