<% content_for :title, "Libraries" %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Libraries</h1>
    <%= link_to "New Library", new_library_path,
          class: "bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg px-4 py-2 text-sm font-medium" %>
  </div>

  <% if @libraries.any? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Kind</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Path</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Videos</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Read Only</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @libraries.each do |library| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-6 py-4">
                <%= link_to library.name, library_path(library),
                      class: "text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline" %>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300">
                  <%= library.kind %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 font-mono truncate max-w-xs"><%= library.path %></td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= library.videos.size %></td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= library.read_only? ? "Yes" : "No" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-6 flex justify-center">
        <%= raw @pagy.series_nav %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-16 text-gray-400 dark:text-gray-500">
      <p class="text-lg">No libraries configured.</p>
      <p class="mt-2">
        <%= link_to "Create your first library", new_library_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline" %>
      </p>
    </div>
  <% end %>

</div>
