<% content_for :title, @person.name %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
  <div class="lg:flex lg:gap-8">

    <%# Profile card %>
    <div class="lg:w-64 xl:w-72 shrink-0 mb-6 lg:mb-0">
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="aspect-[3/4] bg-gray-100 dark:bg-gray-700">
          <% if @person.image.attached? %>
            <img src="<%= image_person_path(@person) %>"
                 alt="<%= @person.name %>"
                 class="w-full h-full object-cover object-top">
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-gray-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            </div>
          <% end %>
        </div>
        <div class="p-4">
          <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= @person.name %></h1>
          <% if @person.favorite %>
            <span class="text-amber-400 text-sm">★ Favorite</span>
          <% end %>

          <dl class="mt-4 space-y-2 text-sm">
            <% if @person.birthdate.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500 dark:text-gray-400">Age</dt>
                <dd class="font-medium text-gray-900 dark:text-gray-100"><%= @person.age %> (<%= @person.birthdate.strftime("%b %-d, %Y") %>)</dd>
              </div>
            <% end %>
            <% if @person.country.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500 dark:text-gray-400">Country</dt>
                <dd class="font-medium text-gray-900 dark:text-gray-100"><%= @person.country %></dd>
              </div>
            <% end %>
            <% if @person.ethnicity.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500 dark:text-gray-400">Ethnicity</dt>
                <dd class="font-medium text-gray-900 dark:text-gray-100"><%= @person.ethnicity %></dd>
              </div>
            <% end %>
            <% if @person.height.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500 dark:text-gray-400">Height</dt>
                <dd class="font-medium text-gray-900 dark:text-gray-100"><%= @person.height %></dd>
              </div>
            <% end %>
            <% if @person.measurements.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500 dark:text-gray-400">Measurements</dt>
                <dd class="font-medium text-gray-900 dark:text-gray-100"><%= @person.measurements %></dd>
              </div>
            <% end %>
            <% if @person.career_length.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500 dark:text-gray-400">Career</dt>
                <dd class="font-medium text-gray-900 dark:text-gray-100"><%= @person.career_length %></dd>
              </div>
            <% end %>
            <% if @person.aliases.present? %>
              <div>
                <dt class="text-gray-500 dark:text-gray-400 mb-1">Aliases</dt>
                <dd class="font-medium text-gray-900 dark:text-gray-100 text-xs"><%= @person.aliases %></dd>
              </div>
            <% end %>
          </dl>

          <% if @person.url.present? %>
            <a href="<%= @person.url %>" target="_blank"
               class="mt-4 block text-sm text-indigo-600 dark:text-indigo-400 hover:underline truncate">
              <%= @person.url %>
            </a>
          <% end %>
        </div>
      </div>
    </div>

    <%# Videos grid %>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Videos</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= raw @pagy.info_tag %></p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
        <% @videos.each do |video| %>
          <%= render "shared/video_card", video: video %>
        <% end %>
      </div>
      <% if @videos.empty? %>
        <p class="text-gray-400 dark:text-gray-500 py-8 text-center">No videos found.</p>
      <% end %>
      <% if @pagy.pages > 1 %>
        <div class="mt-6 flex justify-center">
          <%= raw @pagy.series_nav %>
        </div>
      <% end %>
    </div>

  </div>
</div>
