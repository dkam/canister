<%# Locals: performer %>
<%= link_to performer_path(performer), class: "block bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden text-center group" do %>
  <div class="aspect-square bg-gray-100 overflow-hidden">
    <img src="<%= image_performer_path(performer) %>"
         alt="<%= performer.name %>"
         loading="lazy"
         class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-200">
  </div>
  <div class="p-3">
    <p class="text-sm font-medium text-gray-900 truncate"><%= performer.name %></p>
    <% if performer.respond_to?(:scenes_count) %>
      <p class="text-xs text-gray-400 mt-0.5"><%= performer.scenes_count %> scenes</p>
    <% end %>
    <% if performer.favorite %>
      <span class="text-amber-400 text-xs">★ Favorite</span>
    <% end %>
  </div>
<% end %>
