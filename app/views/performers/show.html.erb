<% content_for :title, @performer.name %>

<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-6">
  <div class="lg:flex lg:gap-8">

    <%# Performer profile card %>
    <div class="lg:w-64 xl:w-72 shrink-0 mb-6 lg:mb-0">
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
        <div class="aspect-[3/4] bg-gray-100">
          <img src="<%= image_performer_path(@performer) %>"
               alt="<%= @performer.name %>"
               class="w-full h-full object-cover object-top">
        </div>
        <div class="p-4">
          <h1 class="text-xl font-bold text-gray-900"><%= @performer.name %></h1>
          <% if @performer.favorite %>
            <span class="text-amber-400 text-sm">★ Favorite</span>
          <% end %>

          <dl class="mt-4 space-y-2 text-sm">
            <% if @performer.birthdate.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Age</dt>
                <dd class="font-medium text-gray-900"><%= @performer.age %> (<%= @performer.birthdate.strftime("%b %-d, %Y") %>)</dd>
              </div>
            <% end %>
            <% if @performer.country.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Country</dt>
                <dd class="font-medium text-gray-900"><%= @performer.country %></dd>
              </div>
            <% end %>
            <% if @performer.ethnicity.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Ethnicity</dt>
                <dd class="font-medium text-gray-900"><%= @performer.ethnicity %></dd>
              </div>
            <% end %>
            <% if @performer.height.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Height</dt>
                <dd class="font-medium text-gray-900"><%= @performer.height %></dd>
              </div>
            <% end %>
            <% if @performer.measurements.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Measurements</dt>
                <dd class="font-medium text-gray-900"><%= @performer.measurements %></dd>
              </div>
            <% end %>
            <% if @performer.career_length.present? %>
              <div class="flex justify-between">
                <dt class="text-gray-500">Career</dt>
                <dd class="font-medium text-gray-900"><%= @performer.career_length %></dd>
              </div>
            <% end %>
            <% if @performer.aliases.present? %>
              <div>
                <dt class="text-gray-500 mb-1">Aliases</dt>
                <dd class="font-medium text-gray-900 text-xs"><%= @performer.aliases %></dd>
              </div>
            <% end %>
          </dl>

          <% if @performer.url.present? %>
            <a href="<%= @performer.url %>" target="_blank"
               class="mt-4 block text-sm text-indigo-600 hover:underline truncate">
              <%= @performer.url %>
            </a>
          <% end %>
        </div>
      </div>
    </div>

    <%# Scenes grid %>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Scenes</h2>
        <p class="text-sm text-gray-500"><%= raw @pagy.info_tag %></p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
        <% @scenes.each do |scene| %>
          <%= render "shared/scene_card", scene: scene %>
        <% end %>
      </div>
      <% if @scenes.empty? %>
        <p class="text-gray-400 py-8 text-center">No scenes found.</p>
      <% end %>
      <div class="mt-6 flex justify-center">
        <%= raw @pagy.series_nav %>
      </div>
    </div>

  </div>
</div>
