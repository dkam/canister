<%# Locals: scene %>
<%= link_to scene_path(scene),
      data: {
        turbo_frame: "_top",
        controller: "scene-card",
        "scene-card-preview-url-value": preview_scene_path(scene)
      },
      class: "block bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow overflow-hidden group" do %>

  <%# Thumbnail / preview %>
  <div class="relative aspect-video bg-gray-100 dark:bg-gray-700 overflow-hidden">
    <img src="<%= screenshot_scene_path(scene) %>"
         alt="<%= scene.title.presence || File.basename(scene.path) %>"
         loading="lazy"
         class="w-full h-full object-cover">
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <video data-scene-card-target="preview"
             muted loop playsinline
             class="w-full h-full object-cover hidden"></video>
    </div>
    <% if scene.duration.present? %>
      <span class="absolute bottom-2 right-2 bg-black/70 text-white text-xs px-1.5 py-0.5 rounded font-mono">
        <%= format_duration(scene.duration) %>
      </span>
    <% end %>
  </div>

  <%# Metadata %>
  <div class="p-3">
    <h3 class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate leading-snug">
      <%= scene.title.presence || File.basename(scene.path, ".*") %>
    </h3>

    <div class="flex items-center gap-2 mt-1 flex-wrap">
      <% if scene.date.present? %>
        <span class="text-xs text-gray-400"><%= scene.date.year %></span>
      <% end %>
      <% if scene.studio.present? %>
        <span class="text-xs bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 px-1.5 py-0.5 rounded font-medium">
          <%= scene.studio.name %>
        </span>
      <% end %>
    </div>

    <% if scene.performers.any? %>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 truncate">
        <%= scene.performers.map(&:name).join(", ") %>
      </p>
    <% end %>

    <% if scene.rating.present? && scene.rating > 0 %>
      <div class="mt-1 text-xs"><%= rating_stars(scene.rating) %></div>
    <% end %>
  </div>
<% end %>
