<%= form_with(model: library, class: "space-y-6 max-w-lg", data: { controller: "library-form" }) do |f| %>

  <% if library.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 rounded-lg p-4">
      <ul class="list-disc list-inside text-sm text-red-700 dark:text-red-300">
        <% library.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-4 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
  </div>

  <div>
    <%= f.label :path, "Path or URL", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :path, class: "w-full border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-4 py-2 text-sm font-mono focus:ring-indigo-500 focus:border-indigo-500",
          placeholder: "/videos",
          data: { library_form_target: "path", action: "input->library-form#pathChanged" } %>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Local path, HTTP/WebDAV URL, or <code class="font-mono">s3://bucket/prefix</code> for S3 endpoints.</p>
  </div>

  <div>
    <%= f.label :kind, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.select :kind, Library.kinds.keys.map { |k| [k.titleize, k] },
          { include_blank: "Auto-detect" },
          class: "w-full border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-4 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500",
          data: { library_form_target: "kind", action: "change->library-form#kindChanged" } %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :read_only, class: "rounded border-gray-300 dark:border-gray-600 text-indigo-600 focus:ring-indigo-500" %>
    <%= f.label :read_only, "Read only", class: "text-sm text-gray-700 dark:text-gray-300" %>
  </div>

  <div>
    <%= f.label :default_video_kind, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.select :default_video_kind, Library.default_video_kinds.keys.map { |k| [k.titleize, k] },
          {}, class: "w-full border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-4 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
  </div>

  <div>
    <%= f.label :username, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :username, class: "w-full border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-4 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500",
          autocomplete: "off" %>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Required for WebDAV, HTTP, and S3 libraries.</p>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.password_field :password, class: "w-full border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-4 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500",
          autocomplete: "off", placeholder: library.persisted? && library.password.present? ? "••••••••" : "" %>
  </div>

  <div>
    <%= f.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg px-6 py-2 text-sm font-medium cursor-pointer" %>
  </div>

<% end %>
